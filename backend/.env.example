# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/lawtrack

# JWT signing secret. Required — the app will refuse to start without it.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Comma-separated list of allowed frontend origins for CORS.
# Leave unset (or "*") to allow all origins (fine for local dev only).
CORS_ORIGINS=http://localhost:5173

# Google Sign-In (optional). Leave both unset and the "Continue with Google"
# button will 503 instead of the app failing to start. Create these at
# https://console.cloud.google.com/apis/credentials — an OAuth 2.0 Client ID
# of type "Web application" — and add BACKEND_URL + "/api/auth/google/callback"
# (both your localhost and production BACKEND_URL) to its Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This backend's own public base URL — used to build the Google OAuth
# redirect_uri. Must exactly match a URI registered in Google Cloud Console.
BACKEND_URL=http://localhost:8000

# The frontend's public base URL — Google sign-in redirects back here
# (with the LawTrack session token in a URL fragment) once it's done.
FRONTEND_URL=http://localhost:5173
