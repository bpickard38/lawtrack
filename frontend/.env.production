# NOTE: verified 2026-08-07 that the live Vercel deployment's compiled bundle
# actually uses https://lawtrack-production.up.railway.app — meaning Vercel's
# dashboard (Settings > Environment Variables) is overriding this file's value
# at build time. The placeholder below is NOT what's live; it exists only as
# a fallback for anyone building locally without Vercel env vars set. If you
# ever unset VITE_API_URL in Vercel, update this line to the real backend URL
# first, or local/CI builds will silently point at a nonexistent host.
VITE_API_URL=lawtrack-production.up.railway.app